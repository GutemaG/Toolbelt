<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>com.birhanu.toolbelt</string>
<key>CFBundleName</key><string>Toolbelt</string>
<key>CFBundleDisplayName</key><string>Toolbelt</string>
<key>CFBundleExecutable</key><string>Toolbelt</string>
<key>CFBundleIconFile</key><string>AppIcon</string>
<key>CFBundleIconName</key><string>AppIcon</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.1</string>
<key>CFBundleVersion</key><string>__BUILD__</string>
<key>LSMinimumSystemVersion</key><string>26.0</string>
<key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
<key>NSHighResolutionCapable</key><true/>
<key>NSPrincipalClass</key><string>NSApplication</string>
<key>LSUIElement</key><true/>
<key>NSAppleEventsUsageDescription</key><string>Toolbelt switches Dark Mode through System Events and empties the Trash through Finder when you ask it to.</string>
<key>NSAudioCaptureUsageDescription</key><string>Toolbelt plays an app you turn down in Volume Mixer at the volume you choose. Nothing is recorded or saved.</string>
<key>NSCameraUsageDescription</key><string>Toolbelt shows your camera in Camera, only while that tool is open.</string>
<key>NSLocationUsageDescription</key><string>Toolbelt shows the name of your Wi-Fi network in Info. macOS counts network names as location.</string>
<key>NSLocationWhenInUseUsageDescription</key><string>Toolbelt shows the name of your Wi-Fi network in Info. macOS counts network names as location.</string>
<key>NSMicrophoneUsageDescription</key><string>Toolbelt records your microphone in screen recordings when you turn on Record microphone.</string>
</dict></plist>
